<section class="pt-40 pb-24 sm:pt-48 sm:pb-32 bg-gray-950 text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-14 items-center">
        <div>
            {% if item.eyebrow %}<p class="text-sm uppercase tracking-widest text-teal-400 mb-6">{{ item.eyebrow }}</p>{% endif %}
            <h1 class="text-5xl lg:text-7xl font-semibold mb-6">{{ item.name }}</h1>
            {% if item.tagline %}<p class="text-2xl text-gray-100 mb-5">{{ item.tagline }}</p>{% endif %}
            {% if item.description %}<p class="text-lg text-gray-300 leading-relaxed">{{ item.description }}</p>{% endif %}
            {% if item.actions|default([]) %}
            <div class="mt-8 flex flex-wrap gap-4">
                {% for action in item.actions %}
                <a href="{{ url_for(action.route) }}" class="inline-flex px-5 py-3 font-semibold {% if action.style == 'primary' %}bg-teal-500 text-gray-950{% else %}border border-gray-500 text-white{% endif %}">{{ action.label }} →</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% if item.hero_media %}
        <figure>
            <img src="{{ asset(item.hero_media) }}" alt="{{ item.hero_media_alt }}" class="w-full">
            {% if item.hero_media_caption %}<figcaption class="mt-3 text-sm text-gray-400">{{ item.hero_media_caption }}</figcaption>{% endif %}
        </figure>
        {% endif %}
    </div>
</section>
