{# Landing page template - the main homepage content #}

{# Identity-appropriate hero section is always displayed #}
{% if hero %}
    {{ render_component(hero_component|default('profile_hero'), item=hero, base_url=base_url) | safe }}
{% endif %}

{# Dynamically render all content sections passed from the builder #}
{% for section in sections %}
    {% if section.rendered_html %}
        {# Divider at the exact intersection between consecutive sections #}
        {% if not loop.first %}
        <div class="elysian-divider"></div>
        {% endif %}
        {{ section.rendered_html | safe }}
    {% endif %}
{% endfor %}
