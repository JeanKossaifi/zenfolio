{# Standalone page template - wrapper for individual pages #}

{% if item.layout == 'full' %}
<article class="page-layout-full page-{{ item.slug }}{% if item.show_site_header %} with-site-header{% else %} without-site-header{% endif %}{% if item.show_site_footer %} with-site-footer{% else %} without-site-footer{% endif %}">
    {{ item.content | safe }}
</article>
{% else %}
<div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="{% if item.layout == 'wide' %}max-w-7xl{% else %}max-w-4xl{% endif %} mx-auto page-{{ item.slug }}">
        
        {# Page header #}
        <header class="text-center my-16 reveal">
            <h1 class="text-5xl lg:text-6xl heading text-gray-900 dark:text-white">
                {{ item.title|default('Page') }}
            </h1>
        </header>

        {# Page content #}
        <article class="prose-main">
            {{ item.content | safe }}
        </article>

        {% if research_areas %}
        <section class="mt-20">
            <h2 class="text-3xl heading mb-8">Research directions</h2>
            <div class="grid md:grid-cols-2 gap-8">
                {% for area in research_areas %}{{ area.rendered_html | safe }}{% endfor %}
            </div>
        </section>
        {% endif %}

        {% if related_publications %}
        <section class="mt-20">
            <h2 class="text-3xl heading mb-8">Related publications</h2>
            <div class="grid gap-8">
                {% for publication in related_publications %}{{ publication.rendered_html | safe }}{% endfor %}
            </div>
        </section>
        {% endif %}

        {% if related_projects %}
        <section class="mt-20">
            <h2 class="text-3xl heading mb-8">Public projects</h2>
            <div class="grid gap-8">
                {% for project in related_projects %}{{ project.rendered_html | safe }}{% endfor %}
            </div>
        </section>
        {% endif %}

    </div>
</div>
{% endif %}
