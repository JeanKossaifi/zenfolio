<article class="border border-gray-200 dark:border-gray-700 p-6">
    {% if item.photo %}
    <img src="{{ asset(item.photo) }}" alt="{{ item.photo_alt or item.name }}" class="w-full aspect-square object-cover mb-5">
    {% endif %}
    <h3 class="text-xl font-semibold">{{ item.name }}</h3>
    {% if item.role %}<p class="text-sm text-teal-700 dark:text-teal-300 mt-1">{{ item.role }}</p>{% endif %}
    {% if item.bio %}<div class="mt-4 text-gray-600 dark:text-gray-300">{{ item.bio | safe }}</div>{% endif %}
    {% if item.profile %}<a href="{{ item.profile }}" class="inline-block mt-4 font-medium text-teal-700 dark:text-teal-300">Profile →</a>{% endif %}
</article>
