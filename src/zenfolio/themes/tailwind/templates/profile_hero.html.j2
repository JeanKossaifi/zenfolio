<section class="relative pt-40 pb-24 sm:pt-48 sm:pb-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center">
            <div class="lg:col-span-3 text-center lg:text-left">
                <div class="space-y-8">
                    <div class="space-y-4">
                        <h1 class="fluid-heading-hero heading text-gray-900 dark:text-white">
                            {{ item.name }}
                        </h1>
                        <p class="text-lg text-gray-600 dark:text-gray-400 font-medium">
                            {{ item.title }}{% if item.affiliation %}, {{ item.affiliation }}{% endif %}
                        </p>
                    </div>
                    {% if item.tagline %}
                    <p class="fluid-text-large text-gray-600 dark:text-gray-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">{{ item.tagline | safe }}</p>
                    {% endif %}
                    
                    {# Research interests moved from bio section #}
                    {% if item.interests %}
                    <div class="flex flex-wrap justify-center lg:justify-start gap-2">
                        {% for interest in item.interests %}
                        <span class="px-4 py-2 text-sm font-semibold bg-teal-50 dark:bg-teal-900/20 text-teal-700 dark:text-teal-300 rounded-full border border-teal-200 dark:border-teal-800/50">{{ interest }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    <div class="space-y-6">
                        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
                            {% if item.actions|default([]) %}
                                {% for action in item.actions %}
                                    {% set action_url = action.route if action.route is defined else action.url %}
                                    {% set action_label = action.label if action.label is defined else action.text %}
                                    <a href="{{ url_for(action_url) }}" class="inline-block px-6 py-3 {% if action.style == 'primary' %}bg-gray-900 dark:bg-white text-white dark:text-gray-900{% elif action.style == 'accent' %}bg-teal-600 dark:bg-teal-400 text-white{% else %}bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white{% endif %} text-base font-semibold rounded-full shadow-sm hover:-translate-y-1 transition-transform" {% if action_url.startswith('http') %}target="_blank" rel="noopener"{% endif %}>{{ action_label }}</a>
                                {% endfor %}
                            {% elif item.homepage_buttons %}
                                {% for button in item.homepage_buttons %}
                                    {% if button.style == "primary" %}
                                        <a href="{{ url_for(button.url) }}" class="inline-block px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-base font-semibold rounded-full shadow-lg hover:-translate-y-1 transition-transform" {% if button.url.startswith('http') %}target="_blank" rel="noopener"{% endif %}>{{ button.text }}</a>
                                    {% elif button.style == "secondary" %}
                                        <a href="{{ url_for(button.url) }}" class="inline-block px-6 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white font-semibold rounded-full shadow-sm hover:-translate-y-1 transition-transform" {% if button.url.startswith('http') %}target="_blank" rel="noopener"{% endif %}>{{ button.text }}</a>
                                    {% elif button.style == "accent" %}
                                        <a href="{{ url_for(button.url) }}" class="inline-block px-6 py-3 bg-teal-600 dark:bg-teal-400 text-white font-semibold rounded-full shadow-sm hover:-translate-y-1 transition-transform" {% if button.url.startswith('http') %}target="_blank" rel="noopener"{% endif %}>{{ button.text }}</a>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <!-- Fallback buttons if no homepage_buttons configured -->
                                <a href="{{ url_for(item.publications_route|default('/publications.html')) }}" class="inline-block px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-base font-semibold rounded-full shadow-lg hover:-translate-y-1 transition-transform">View Publications</a>
                                <a href="mailto:{{ item.email }}" class="inline-block px-6 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white font-semibold rounded-full shadow-sm hover:-translate-y-1 transition-transform">Get in Touch</a>
                            {% endif %}
                            {% if item.cv_path %}<a href="{{ item.cv_path }}" target="_blank" rel="noopener" class="inline-block px-6 py-3 bg-teal-600 dark:bg-teal-400 text-white font-semibold rounded-full shadow-sm hover:-translate-y-1 transition-transform">Download CV</a>{% endif %}
                        </div>
                        <div class="flex justify-center lg:justify-start gap-4 text-gray-500 dark:text-gray-400">
                            {% if item.github %}<a href="{{ item.github }}" target="_blank" rel="noopener" aria-label="GitHub" class="social-icon-link"><i class="fab fa-github fa-lg"></i></a>{% endif %}
                            {% if item.scholar %}<a href="{{ item.scholar }}" target="_blank" rel="noopener" aria-label="Google Scholar" class="social-icon-link"><i class="fas fa-graduation-cap fa-lg"></i></a>{% endif %}
                            {% if item.linkedin %}<a href="{{ item.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-icon-link"><i class="fab fa-linkedin fa-lg"></i></a>{% endif %}
                            {% if item.twitter %}<a href="{{ item.twitter }}" target="_blank" rel="noopener" aria-label="Twitter" class="social-icon-link"><i class="fab fa-twitter fa-lg"></i></a>{% endif %}
                        </div>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-2 relative flex justify-center order-first lg:order-last">
                {% if item.photo_path or item.photo %}
                <div class="relative w-80 h-80 lg:w-[28rem] lg:h-[28rem]">
                     <img src="{{ asset(item.photo or item.photo_path) }}" alt="{{ item.name }}" class="relative w-full h-full object-cover rounded-full shadow-2xl ring-1 ring-gray-200 dark:ring-gray-700">
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
