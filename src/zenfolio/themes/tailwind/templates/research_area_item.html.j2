<article class="border border-gray-200 dark:border-gray-700 p-6">
    {% if item.image %}
    <img src="{{ asset(item.image) }}" alt="{{ item.image_alt or item.title }}" class="w-full aspect-video object-cover mb-5">
    {% endif %}
    <h3 class="text-xl font-semibold">{{ item.title }}</h3>
    <div class="mt-3 text-gray-600 dark:text-gray-300">{{ item.description | safe }}</div>
    {% if item.tags %}
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="{{ item.title }} topics">
        {% for tag in item.tags %}<li class="text-sm text-gray-500">{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
</article>
