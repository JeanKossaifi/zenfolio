<section id="{{ section_id }}" data-section="{{ section_id }}" class="py-24 sm:py-32 {{ 'bg-gray-50/50 dark:bg-gray-800/50' if background|default(false) }}">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-16">
            <h2 class="text-4xl lg:text-5xl heading text-gray-900 dark:text-white mb-4">{{ title }}</h2>
            {% if subtitle|default('') %}<p class="mt-6 text-xl text-gray-600 dark:text-gray-300 max-w-3xl">{{ subtitle }}</p>{% endif %}
        </div>

        {# Section Content #}
            {% if steps|default([]) %}
            <div class="grid grid-cols-1 {% if grid_cols|default(1) == 2 %}md:grid-cols-2{% elif grid_cols|default(1) == 3 %}md:grid-cols-2 lg:grid-cols-3{% elif grid_cols|default(1) >= 4 %}md:grid-cols-2 lg:grid-cols-4{% endif %} gap-8">
                {% for step in steps %}
                <article class="border border-gray-200 dark:border-gray-700 p-6">
                    <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{{ step.title }}</h3>
                    {% if step.description %}<p class="mt-3 text-gray-600 dark:text-gray-300">{{ step.description }}</p>{% endif %}
                </article>
                {% endfor %}
            </div>
            {% elif layout|default('grid') == 'timeline' %}
            <div class="timeline-container">
                {% for item in items|default([]) %}{{ item.rendered_html | safe }}{% endfor %}
            </div>
            {% elif layout|default('grid') == 'bio' %}
            <div class="prose-bio max-w-4xl mx-auto">
                {{ content | safe }}
            </div>
            {% elif layout|default('grid') == 'service' %}
            <div class="grid grid-cols-1 gap-8">
                {# Leadership & Editorial Section #}
                {% if items.leadership_items %}
                <h3 class="text-2xl font-semibold heading text-gray-900 dark:text-white mb-6 mt-0">Leadership & Editorial</h3>
                {% for item in items.leadership_items %}{{ item.rendered_html | safe }}{% endfor %}
                {% endif %}

                            {# Peer Review Section #}
            {% if items.review_groups %}
                <h3 class="text-2xl font-semibold heading text-gray-900 dark:text-white mb-6 mt-8">Peer Review</h3>
                {% for group_name, group_items in items.review_groups.items()|sort %}
                    <h4 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mt-4 mb-2">{{ group_name }}</h4>
                    <div class="flex flex-wrap gap-2">
                        {% for item in group_items %}
                        <span class="inline-flex items-center gap-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 px-3 py-2 rounded-lg text-sm font-medium mr-2 mb-2 hover:border-gray-300 dark:hover:border-gray-600 transition-colors">
                            <span class="font-medium">{{ item.venue }}</span>
                            {% if item.highlight %}
                            <span class="text-xs bg-yellow-200 dark:bg-yellow-400/30 text-gray-900 dark:text-yellow-100 px-1.5 py-0.5 rounded font-medium">{{ item.highlight|title }}</span>
                            {% endif %}
                            <span class="text-xs font-medium text-teal-600 dark:text-teal-400">{{ item.date }}</span>
                        </span>
                        {% endfor %}
                    </div>
                {% endfor %}
            {% endif %}
            </div>
            {% else %}
            <div class="grid grid-cols-1 {% if grid_cols|default(1) == 2 %}md:grid-cols-2{% elif grid_cols|default(1) >= 3 %}md:grid-cols-2 lg:grid-cols-3{% endif %} gap-8">
                {% for item in items|default([]) %}{{ item.rendered_html | safe }}{% endfor %}
            </div>
            {% endif %}
            {% if actions|default([]) %}
            <div class="mt-10 flex flex-wrap gap-4">
                {% for action in actions %}
                <a href="{{ url_for(action.route) }}" class="font-semibold text-teal-600 dark:text-teal-400">{{ action.label }} →</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% if view_all_link|default(false) %}
        <div class="mt-16 text-center">
            <a href="{{ url_for(view_all_link.url) }}" class="inline-flex items-center gap-2 text-lg font-semibold text-teal-600 dark:text-teal-400 hover:gap-3 transition-all">
                {{ view_all_link.text }} 
                <i class="fas fa-arrow-right text-sm"></i>
            </a>
        </div>
        {% endif %}
    </div>
</section>